// 세무기장대리 서비스 - 멀티테넌트 데이터 모델
// 테넌트 = 세무사 사무소(Firm)
// 세무사 사무소는 다수의 고객사(Client)를 관리하고,
// 각 고객사는 자체 사용자(고객사 담당자)를 가진다.
//
// 회계: 복식부기 (JournalEntry 헤더 + JournalLine N개)
// 부가세 신고용 메타데이터(공급가액/부가세/매출·매입 구분)는 헤더에 함께 보관해
// VAT 집계 시 라인 합산 없이도 빠르게 신고서를 만들 수 있도록 한다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ACCOUNTANT
  CLIENT
}

enum BizType {
  CORPORATION
  SOLE_GENERAL
  SOLE_SIMPLIFIED
  SOLE_TAX_FREE
}

enum TxnDirection {
  SALE
  PURCHASE
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Firm {
  id        String   @id @default(cuid())
  name      String
  bizNo     String?
  createdAt DateTime @default(now())

  users   User[]
  clients Client[]
}

model Client {
  id        String   @id @default(cuid())
  firmId    String
  name      String
  bizNo     String
  ownerName String?
  bizType   BizType  @default(SOLE_GENERAL)
  industry  String?
  openedAt  DateTime?
  createdAt DateTime @default(now())

  firm           Firm           @relation(fields: [firmId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  accounts       Account[]
  journalEntries JournalEntry[]
  payrolls       PayrollEntry[]

  @@unique([firmId, bizNo])
  @@index([firmId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         UserRole
  firmId       String?
  passwordHash String?
  createdAt    DateTime @default(now())

  firm        Firm?        @relation(fields: [firmId], references: [id], onDelete: SetNull)
  memberships Membership[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  clientId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([clientId])
}

// ── 회계 (복식부기) ──────────────────────────────────────────

model Account {
  id       String      @id @default(cuid())
  clientId String
  code     String      // 계정과목 코드 (401, 146, 255 등)
  name     String      // 매출, 매출채권, 부가세예수금 등
  type     AccountType

  client Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lines  JournalLine[]

  @@unique([clientId, code])
  @@index([clientId])
}

// 분개 헤더: 한 거래(전표) 단위
model JournalEntry {
  id           String        @id @default(cuid())
  clientId     String
  occurredOn   DateTime
  description  String?
  counterparty String?
  // 부가세 신고 보조 메타 (VAT 신고서 합계표 빠른 집계용)
  vatDirection TxnDirection? // null이면 부가세 미관련 분개
  supplyAmount Int           @default(0)
  vatAmount    Int           @default(0)
  totalAmount  Int           @default(0)
  isTaxInvoice Boolean       @default(false)
  createdAt    DateTime      @default(now())

  client Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lines  JournalLine[]

  @@index([clientId, occurredOn])
  @@index([clientId, vatDirection])
}

// 분개 라인: 차변/대변 합이 일치해야 한다 (애플리케이션 레벨에서 검증)
model JournalLine {
  id        String @id @default(cuid())
  entryId   String
  accountId String
  debit     Int    @default(0)
  credit    Int    @default(0)
  memo      String?

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([accountId])
}

// ── 급여 ────────────────────────────────────────────────────

model PayrollEntry {
  id              String   @id @default(cuid())
  clientId        String
  payDate         DateTime
  employeeName    String
  dependents      Int      @default(1)
  childrenUnder20 Int      @default(0)
  grossPay        Int
  nonTaxablePay   Int      @default(0)
  incomeTax       Int      @default(0)
  localIncomeTax  Int      @default(0)
  nationalPension Int      @default(0)
  healthIns       Int      @default(0)
  longTermCare    Int      @default(0)
  employmentIns   Int      @default(0)
  createdAt       DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, payDate])
}
