// 세무기장대리 서비스 - 멀티테넌트 데이터 모델
// SQLite는 Prisma enum 미지원이라 String + 애플리케이션 레벨 union 타입을 사용한다.
// PostgreSQL 마이그레이션 시 enum으로 복원할 것.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// String 컬럼에 들어가는 union 값 (애플리케이션 레벨에서 강제):
//   UserRole:     "ACCOUNTANT" | "CLIENT"
//   BizType:      "CORPORATION" | "SOLE_GENERAL" | "SOLE_SIMPLIFIED" | "SOLE_TAX_FREE"
//   TxnDirection: "SALE" | "PURCHASE"
//   AccountType:  "ASSET" | "LIABILITY" | "EQUITY" | "REVENUE" | "EXPENSE"

model Firm {
  id        String   @id @default(cuid())
  name      String
  bizNo     String?
  createdAt DateTime @default(now())

  users   User[]
  clients Client[]
}

model Client {
  id        String   @id @default(cuid())
  firmId    String
  name      String
  bizNo     String
  ownerName String?
  bizType   String   @default("SOLE_GENERAL")
  industry  String?
  openedAt  DateTime?
  createdAt DateTime @default(now())

  firm           Firm           @relation(fields: [firmId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  accounts       Account[]
  journalEntries JournalEntry[]
  payrolls       PayrollEntry[]

  @@unique([firmId, bizNo])
  @@index([firmId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         String
  firmId       String?
  passwordHash String?
  createdAt    DateTime @default(now())

  firm        Firm?        @relation(fields: [firmId], references: [id], onDelete: SetNull)
  memberships Membership[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  clientId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([clientId])
}

model Account {
  id       String @id @default(cuid())
  clientId String
  code     String
  name     String
  type     String

  client Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lines  JournalLine[]

  @@unique([clientId, code])
  @@index([clientId])
}

model JournalEntry {
  id           String   @id @default(cuid())
  clientId     String
  occurredOn   DateTime
  description  String?
  counterparty String?
  vatDirection String?  // "SALE" | "PURCHASE" | null
  supplyAmount Int      @default(0)
  vatAmount    Int      @default(0)
  totalAmount  Int      @default(0)
  isTaxInvoice Boolean  @default(false)
  createdAt    DateTime @default(now())

  client Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lines  JournalLine[]

  @@index([clientId, occurredOn])
  @@index([clientId, vatDirection])
}

model JournalLine {
  id        String  @id @default(cuid())
  entryId   String
  accountId String
  debit     Int     @default(0)
  credit    Int     @default(0)
  memo      String?

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([accountId])
}

model PayrollEntry {
  id              String   @id @default(cuid())
  clientId        String
  payDate         DateTime
  employeeName    String
  dependents      Int      @default(1)
  childrenUnder20 Int      @default(0)
  grossPay        Int
  nonTaxablePay   Int      @default(0)
  incomeTax       Int      @default(0)
  localIncomeTax  Int      @default(0)
  nationalPension Int      @default(0)
  healthIns       Int      @default(0)
  longTermCare    Int      @default(0)
  employmentIns   Int      @default(0)
  createdAt       DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, payDate])
}
