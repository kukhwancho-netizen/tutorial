# 주간 블로그 편성봇 — 환경 변수 템플릿
#
# 이 파일을 .env로 복사한 뒤 실제 값을 채운다:
#   cp .env.example .env
#
# 최소 필수: OPENAI_API_KEY 만 있어도 dry-run 가능.
# 실제 live 호출 시: + GOOGLE_TOKEN_JSON (Calendar 사용 시).
# 알림 사용 시: + SLACK_WEBHOOK_URL 또는 SMTP_*.

# ----- OpenAI (필수) -----
OPENAI_API_KEY=sk-...

# ----- Google Calendar (live 모드 + 캘린더 사용 시 필수) -----
# token.json의 내용을 한 줄로 (개행 없이).
# 첫 발급:
#   1) Google Cloud Console에서 OAuth 2.0 Client ID (Desktop app) 발급 → credentials.json
#   2) 첫 실행 시 GOOGLE_CLIENT_SECRET_FILE 또는 GOOGLE_CLIENT_SECRET_JSON 사용해 브라우저 인증
#   3) 인증 후 생성된 token.json 내용을 GOOGLE_TOKEN_JSON에 붙여넣기
#   4) credentials.json은 더 이상 안 써도 됨 (refresh token으로 자동 갱신).
GOOGLE_TOKEN_JSON=

# (선택) 첫 OAuth용. token이 만료/없을 때만 사용.
GOOGLE_CLIENT_SECRET_JSON=
GOOGLE_CLIENT_SECRET_FILE=client_secret.json
# (선택) token.json 파일을 다른 경로에 두려면 지정.
GOOGLE_TOKEN_FILE=token.json

# ----- (선택) 모델 ID env override -----
# 비워두면 config/weekly_blog_bot.yaml의 models.* 값 사용. 환경별로 모델 갈아끼우거나
# 비밀스럽게 다른 ID를 쓰고 싶을 때만 채움.
OPENAI_MODEL_GENERATOR=
OPENAI_MODEL_REPAIR=
OPENAI_MODEL_REPORT=
OPENAI_MODEL_REVIEWER_R1=
OPENAI_MODEL_REVIEWER_R2=
OPENAI_MODEL_REVIEWER_R3=

# ----- Slack 알림 (선택) -----
# 봇이 abort/blocked/needs_repair/human_gate 발생 시 webhook으로 한 줄 알림.
SLACK_WEBHOOK_URL=

# ----- 이메일 알림 (선택, SMTPS 권장) -----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
