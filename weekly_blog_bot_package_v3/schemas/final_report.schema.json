{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WeeklyFinalReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "run_status", "basis_date", "order", "summary", "usage", "items", "next_actions"],
  "properties": {
    "run_id": {"type": "string", "minLength": 10},
    "run_status": {"type": "string", "enum": ["completed", "dry_run", "aborted"]},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "message"],
      "properties": {
        "category": {"type": "string"},
        "message": {"type": "string"},
        "details": {"type": "object", "additionalProperties": true}
      }
    },
    "basis_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "order": {"type": "string", "minLength": 3},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publish_candidates", "needs_repair", "blocked", "human_gate", "dry_run_skipped"],
      "properties": {
        "publish_candidates": {"type": "integer", "minimum": 0},
        "needs_repair": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "human_gate": {"type": "integer", "minimum": 0},
        "dry_run_skipped": {"type": "integer", "minimum": 0}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by_model", "total", "estimated_cost_usd", "cost_warnings"],
      "properties": {
        "by_model": {"type": "object", "additionalProperties": true},
        "total": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_tokens", "cached_input_tokens", "output_tokens", "web_search_calls"],
          "properties": {
            "input_tokens": {"type": "integer", "minimum": 0},
            "cached_input_tokens": {"type": "integer", "minimum": 0},
            "output_tokens": {"type": "integer", "minimum": 0},
            "web_search_calls": {"type": "integer", "minimum": 0}
          }
        },
        "estimated_cost_usd": {"type": "number", "minimum": 0},
        "cost_warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["temp_id", "domain", "topic", "final_status", "risk", "review_summary", "spec_markdown"],
        "properties": {
          "temp_id": {"type": "string"},
          "domain": {"type": "string"},
          "topic": {"type": "string"},
          "final_status": {"type": "string", "enum": ["통과", "수정 필요", "보류", "검수 생략(dry-run)"]},
          "risk": {"type": "string", "enum": ["low", "medium", "high"]},
          "review_summary": {"type": "string"},
          "spec_markdown": {"type": "string"}
        }
      }
    },
    "next_actions": {"type": "array", "items": {"type": "string"}}
  }
}
