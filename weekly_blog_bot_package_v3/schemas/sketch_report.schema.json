{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WeeklySketchReport",
  "description": "spec sketch 단계의 결과 리포트. 검수가 없으므로 review_summary/final_status 없음.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "run_status", "basis_date", "order", "summary", "usage", "items", "next_actions"],
  "properties": {
    "run_id": {"type": "string", "minLength": 10},
    "run_status": {"type": "string", "enum": ["completed", "dry_run", "aborted"]},
    "basis_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "order": {"type": "string", "minLength": 3},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "message"],
      "properties": {
        "category": {"type": "string"},
        "message": {"type": "string"},
        "details": {"type": "object", "additionalProperties": true}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sketches", "high_risk_hint"],
      "properties": {
        "sketches": {"type": "integer", "minimum": 0},
        "high_risk_hint": {"type": "integer", "minimum": 0}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by_model", "total", "estimated_cost_usd", "cost_warnings"],
      "properties": {
        "by_model": {"type": "object", "additionalProperties": true},
        "total": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_tokens", "cached_input_tokens", "output_tokens", "web_search_calls"],
          "properties": {
            "input_tokens": {"type": "integer", "minimum": 0},
            "cached_input_tokens": {"type": "integer", "minimum": 0},
            "output_tokens": {"type": "integer", "minimum": 0},
            "web_search_calls": {"type": "integer", "minimum": 0}
          }
        },
        "estimated_cost_usd": {"type": "number", "minimum": 0},
        "cost_warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["temp_id", "channel", "topic", "risk_hint"],
        "properties": {
          "temp_id": {"type": "string"},
          "channel": {"type": "string"},
          "topic": {"type": "string"},
          "risk_hint": {"type": "string"},
          "rationale": {"type": "string"}
        }
      }
    },
    "next_actions": {"type": "array", "items": {"type": "string"}}
  }
}
