{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WeeklySpecBatch",
  "type": "object",
  "additionalProperties": false,
  "required": ["order", "basis_date", "context_summary", "items", "batch_risk", "handoff"],
  "properties": {
    "order": {"type": "string", "minLength": 3},
    "basis_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "context_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calendar_window", "used_sources", "excluded_sources", "duplicate_scan_basis"],
      "properties": {
        "calendar_window": {"type": "string"},
        "used_sources": {"type": "array", "items": {"type": "string"}},
        "excluded_sources": {"type": "array", "items": {"type": "string"}},
        "duplicate_scan_basis": {"type": "array", "items": {"type": "string"}}
      }
    },
    "items": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "temp_id", "channel", "domain", "topic", "reader_situation", "core_conclusion",
          "differentiation", "failure_point", "must_include", "outline", "keyword_strategy",
          "tag_strategy", "local_point", "related_existing_content", "claims", "risk", "status"
        ],
        "properties": {
          "temp_id": {"type": "string", "pattern": "^콘텐츠 [1-7]$"},
          "channel": {"type": "string", "enum": ["블로그", "홈페이지"]},
          "domain": {"type": "string", "minLength": 2},
          "topic": {"type": "string", "minLength": 5},
          "reader_situation": {"type": "string", "minLength": 10},
          "core_conclusion": {"type": "string", "minLength": 10},
          "differentiation": {"type": "string", "minLength": 10},
          "failure_point": {"type": "string", "minLength": 10},
          "must_include": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 2}},
          "outline": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 2}},
          "keyword_strategy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["primary_naver", "primary_google_ai", "secondary", "longtail", "practical", "local", "intro_reflected", "ai_friendly_section"],
            "properties": {
              "primary_naver": {"type": "string", "minLength": 2},
              "primary_google_ai": {"type": "string", "minLength": 5},
              "secondary": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "string"}},
              "longtail": {"type": "array", "minItems": 2, "maxItems": 5, "items": {"type": "string"}},
              "practical": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string"}},
              "local": {"type": "array", "maxItems": 2, "items": {"type": "string"}},
              "intro_reflected": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string"}},
              "ai_friendly_section": {"type": "string", "minLength": 2}
            }
          },
          "tag_strategy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["representative", "secondary", "practical", "local", "excluded", "total_count"],
            "properties": {
              "representative": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "string", "pattern": "^#"}},
              "secondary": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "string", "pattern": "^#"}},
              "practical": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "pattern": "^#"}},
              "local": {"type": "array", "maxItems": 2, "items": {"type": "string", "pattern": "^#"}},
              "excluded": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string"}},
              "total_count": {"type": "integer", "minimum": 5, "maximum": 8}
            }
          },
          "local_point": {"type": "string", "minLength": 5},
          "related_existing_content": {"type": "string", "minLength": 5},
          "claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "tag", "source"],
              "properties": {
                "value": {"type": "string", "minLength": 1},
                "tag": {"type": "string", "enum": ["실측", "추정", "원칙", "관례"]},
                "source": {"type": "string", "minLength": 10}
              }
            }
          },
          "risk": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level", "reason", "human_gate_required"],
            "properties": {
              "level": {"type": "string", "enum": ["low", "medium", "high"]},
              "reason": {"type": "string", "minLength": 5},
              "human_gate_required": {"type": "boolean"}
            }
          },
          "status": {"type": "string", "enum": ["publish_candidate", "needs_repair", "blocked"]}
        }
      }
    },
    "batch_risk": {"type": "string", "enum": ["low", "medium", "high"]},
    "handoff": {"type": "string"}
  }
}
