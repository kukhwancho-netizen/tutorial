{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WeeklySpecBatch",
  "description": "토픽 스케치 N건. 본문·키워드·태그·outline은 draft 단계에서 결정한다. 중복은 calendar/completed_topic_db로 거른다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["order", "basis_date", "context_summary", "items", "batch_risk", "handoff"],
  "properties": {
    "order": {"type": "string", "minLength": 3},
    "basis_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "context_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calendar_window", "used_sources", "excluded_sources", "duplicate_scan_basis"],
      "properties": {
        "calendar_window": {"type": "string"},
        "used_sources": {"type": "array", "items": {"type": "string"}},
        "excluded_sources": {"type": "array", "items": {"type": "string"}},
        "duplicate_scan_basis": {"type": "array", "items": {"type": "string"}}
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["temp_id", "channel", "topic", "risk_hint"],
        "properties": {
          "temp_id": {"type": "string", "pattern": "^콘텐츠 [1-9][0-9]?$"},
          "channel": {"type": "string", "enum": ["블로그", "홈페이지"]},
          "topic": {"type": "string", "minLength": 8},
          "risk_hint": {"type": "string", "enum": ["low", "medium", "high"]},
          "rationale": {"type": "string"}
        }
      }
    },
    "batch_risk": {"type": "string", "enum": ["low", "medium", "high"]},
    "handoff": {"type": "string"}
  }
}
