{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WeeklyDraftBatch",
  "description": "초안 변주 N건. 한 부모 spec(콘텐츠 N) 1건에서 axis 위의 variants 만큼 본문을 만든다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order", "basis_date", "parent_spec_id", "parent_basis_date",
    "axis", "items", "batch_risk", "handoff"
  ],
  "properties": {
    "order": {"type": "string", "minLength": 3},
    "basis_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "parent_spec_id": {"type": "string", "pattern": "^콘텐츠 [1-9][0-9]?$"},
    "parent_basis_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "axis": {"type": "string", "enum": ["각도", "길이", "후보", "버전"]},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "temp_id", "axis_value", "title", "lede", "body_outline",
          "body_paragraphs", "claims", "tone_profile", "length_target",
          "risk", "status"
        ],
        "properties": {
          "temp_id": {
            "type": "string",
            "pattern": "^콘텐츠 [1-9][0-9]?\\.[A-Za-z0-9가-힣]+$"
          },
          "axis_value": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 5},
          "lede": {"type": "string", "minLength": 30},
          "body_outline": {
            "type": "array",
            "minItems": 4,
            "items": {"type": "string", "minLength": 2}
          },
          "body_paragraphs": {
            "type": "array",
            "minItems": 4,
            "items": {"type": "string", "minLength": 50}
          },
          "claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "tag", "source"],
              "properties": {
                "value": {"type": "string", "minLength": 1},
                "tag": {"type": "string", "enum": ["실측", "추정", "원칙", "관례"]},
                "source": {"type": "string", "minLength": 10}
              }
            }
          },
          "tone_profile": {
            "type": "string",
            "enum": ["법률상담", "안내문", "사례중심", "비교형"]
          },
          "length_target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min_chars", "max_chars"],
            "properties": {
              "min_chars": {"type": "integer", "minimum": 200},
              "max_chars": {"type": "integer", "minimum": 300}
            }
          },
          "risk": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level", "reason", "human_gate_required"],
            "properties": {
              "level": {"type": "string", "enum": ["low", "medium", "high"]},
              "reason": {"type": "string", "minLength": 5},
              "human_gate_required": {"type": "boolean"}
            }
          },
          "status": {
            "type": "string",
            "enum": ["publish_candidate", "needs_repair", "blocked"]
          }
        }
      }
    },
    "batch_risk": {"type": "string", "enum": ["low", "medium", "high"]},
    "handoff": {"type": "string"}
  }
}
